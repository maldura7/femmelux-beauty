# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in the values

# ============================================
# DATABASE (Managed by DigitalOcean)
# ============================================
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET="your-production-access-secret"
JWT_REFRESH_SECRET="your-production-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# REDIS (Optional - for caching and sessions)
# ============================================
# Use DigitalOcean Managed Redis or Redis Cloud
REDIS_URL="rediss://user:password@host:port"

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
NODE_ENV=production

# ============================================
# CORS
# ============================================
# Your production frontend URLs
CORS_ORIGINS="https://femmelux.com,https://admin.femmelux.com"

# ============================================
# FILE UPLOADS
# ============================================
# For production, use DigitalOcean Spaces or AWS S3
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,image/gif"

# Optional: DigitalOcean Spaces for file storage
# DO_SPACES_KEY=""
# DO_SPACES_SECRET=""
# DO_SPACES_ENDPOINT=""
# DO_SPACES_BUCKET=""
# DO_SPACES_CDN_ENDPOINT=""

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-email-password"
SMTP_FROM="FemmeLux Beauty <noreply@femmelux.com>"

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
